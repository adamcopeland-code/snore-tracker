{
  "name": "snore-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Snore Tracker. Web app (GitHub Pages) and native iPhone app (Capacitor).",
  "scripts": {
    "sync": "node scripts/sync-web.mjs && cap sync ios",
    "assets": "node scripts/make-assets.mjs && capacitor-assets generate --ios --iconBackgroundColor '#1b2152' --iconBackgroundColorDark '#1b2152' --splashBackgroundColor '#1b2152' --splashBackgroundColorDark '#1b2152'"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
